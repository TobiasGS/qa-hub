# Copie para .env.local (dev) ou configure como secrets no Cloudflare (produção).

# "mock" usa dados de exemplo em memória; "real" fala com o Kiwi em KIWI_URL.
KIWI_MODE=mock
KIWI_URL=https://localhost

# Em dev, o Kiwi local usa certificado autoassinado. Só aqui, nunca em produção:
# NODE_TLS_REJECT_UNAUTHORIZED=0

# Cifra o cookie de sessão do QA Hub. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-por-uma-string-aleatoria-de-64-caracteres-hex-0000000000

# ID do bug tracker cadastrado no Kiwi (Admin > Test cases > Bug trackers; o número na URL).
KIWI_BUG_TRACKER_ID=1

# Links dos cards. As chaves são jira-86 e azure-86 (AB#86, SHOP-86 e links colados também são aceitos).
# {key} vira o número no Azure e <projeto>-número no Jira.
REQUIREMENT_URL_JIRA=https://sua-empresa.atlassian.net/browse/{key}
# Projeto Jira padrão: a chave jira-86 vira <projeto>-86 no link (outros projetos: jira-OUTRO-86).
JIRA_PROJECT_KEY=SHOP
# Azure DevOps Services: https://dev.azure.com/<org>/<projeto>/_workitems/edit/{key}
# Azure DevOps Server (on-premises): https://<servidor>/tfs/<coleção>/<projeto>/_workitems/edit/{key}
REQUIREMENT_URL_AZURE=https://<servidor>/tfs/<coleção>/<projeto>/_workitems/edit/{key}

# Azure DevOps: o QA Hub cria o bug e a tarefa "Plano de Teste" como filhos do card do plano (azure-N).
# Nuvem: https://dev.azure.com/<org>/<projeto>  ·  Server: https://<servidor>/tfs/<coleção>/<projeto>
AZURE_DEVOPS_URL=https://<servidor>/tfs/<coleção>/<projeto>
# PAT com escopo "Work Items (Read & Write)". É segredo: só no .env.local ou em "wrangler secret put".
# AZURE_DEVOPS_PAT=
AZURE_API_VERSION=6.0
# Tipo do work item criado: "Bug" (Agile/Scrum/CMMI) ou "Issue" (processo Basic).
AZURE_BUG_TYPE=Bug
# Tipo da tarefa "Plano de Teste" criada no card, e os estados que ela recebe conforme os runs.
AZURE_TASK_TYPE=Tarefa
# AZURE_STATE_TESTING=Em Teste
# AZURE_STATE_PASSED=Concluído
# Campo de horas exigido para fechar a Tarefa (preenchido com o tempo medido nos runs).
# AZURE_COMPLETED_WORK_FIELD=Microsoft.VSTS.Scheduling.CompletedWork
# AZURE_STATE_FAILED=Teste Recusado

# IA (gerar casos da história, diagnosticar falhas, gerar Playwright).
# Com ANTHROPIC_API_KEY, o QA Hub chama o Claude direto (análise da história + cenários).
# Sem ela, usa o n8n (abaixo), se configurado.
# Chave do Console da Anthropic (conta da empresa). Só no servidor; nunca no git.
# ANTHROPIC_API_KEY=
# Modelo (opcional): padrão claude-opus-5-5.
# ANTHROPIC_MODEL=

# n8n (usado enquanto não há ANTHROPIC_API_KEY): workflows em n8n/*.workflow.json.
# No container use http://host.docker.internal:5678/webhook/qahub-gerar-casos
N8N_WEBHOOK_URL=http://localhost:5678/webhook/qahub-gerar-casos
# Mesmo valor da credencial Header Auth (X-QAHub-Secret) no n8n. Gere como o SESSION_SECRET.
# N8N_WEBHOOK_SECRET=
# Diagnóstico e Playwright: por padrão, o mesmo n8n em /webhook/qahub-diagnosticar-falhas e /webhook/qahub-gerar-playwright.
# N8N_DIAGNOSE_URL=
# N8N_PLAYWRIGHT_URL=

# Avisos no Teams (run concluído, diagnóstico pronto): URL do fluxo do Teams
# "Post to a channel when a webhook request is received". Os links usam o QA_HUB_URL (abaixo).
# TEAMS_WEBHOOK_URL=

# Testes automatizados (Playwright no pipeline): POST /api/automation/results.
# Token que o pipeline manda no cabeçalho X-QAHub-Token (gere como o SESSION_SECRET).
# AUTOMATION_TOKEN=
# Usuário técnico do Kiwi que grava os resultados (grupo Tester).
# KIWI_CI_USER=ci-bot
# KIWI_CI_PASSWORD=
# Chave das senhas de automação dos projetos (opcional; sem ela, usa o SESSION_SECRET).
# Trocar a chave exige salvar as senhas de novo em Projetos → Configurar automação.
# AUTOMATION_SECRET=

# Evidências: "local" grava em web/.evidence (dev); "r2" usa o bucket do Cloudflare (produção).
EVIDENCE_STORAGE=local
# Endereço público do QA Hub, usado no link da evidência que fica no Kiwi.
QA_HUB_URL=http://localhost:3000

# Service token do Cloudflare Access, se o Kiwi estiver protegido por ele.
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=
